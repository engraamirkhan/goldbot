[Unit]
# The followed TradingView authors' published ideas (goldbot/data/tv_ideas.py, RUNBOOK 2.7d): a read-only poll every
# 12-15 min of TradingView's public ideas listing, no cookie, into /opt/goldbot/state/tv_ideas.db. A failed poll never
# exits (it backs off); a crash restarts, at most 5 times in 10 min, so a broken release does not hammer TradingView.
StartLimitIntervalSec=600
StartLimitBurst=5
Description=goldbot TradingView author ideas (follow: one read-only poll every 12-15 min)
After=network-online.target
Wants=network-online.target

[Service]
User=goldbot
WorkingDirectory=/opt/goldbot
Environment=PYTHON_KEYRING_BACKEND=keyring.backends.fail.Keyring
ExecStart=/opt/goldbot/.venv/bin/python -m goldbot.ops.run tv-ideas follow --state /opt/goldbot/state
Restart=on-failure
RestartSec=60
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/goldbot/state /opt/goldbot/logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
