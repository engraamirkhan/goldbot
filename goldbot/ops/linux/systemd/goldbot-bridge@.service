[Unit]
# never give up restarting (a bridge outage causes fast exits on purpose)
StartLimitIntervalSec=0
Description=goldbot MT5 bridge for account %i (terminal under Wine)
After=network-online.target goldbot-xvfb.service
Requires=goldbot-xvfb.service

[Service]
User=mt5
WorkingDirectory=/opt/goldbot
Environment=DISPLAY=:99 WINEDEBUG=-all PYTHON_KEYRING_BACKEND=keyring.backends.fail.Keyring
# starts the terminal itself (saved login) and serves it to the brain; restarts if the terminal or Wine dies.
# The interpreter by absolute path ($WINPY in mt5_bootstrap.sh): with a bare `python`, Windows lookup would run a
# python.exe from the working directory (/opt/goldbot, writable by mt5) first.
ExecStart=/usr/bin/wine /home/mt5/.wine/drive_c/users/mt5/AppData/Local/Programs/Python/Python311/python.exe -m goldbot.ops.run bridge %i
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
