[Unit]
# TradingView direct pull, read-only (ADR 0030, RUNBOOK 2.7c). Not installed or enabled by brain_bootstrap.sh: only after
# the owner has stored tradingview-sessionid and tradingview-sessionid-sign and tv_pull.enabled is true in
# config/settings.local.yaml. A failed pass never exits (it backs off); a crash restarts, at most 5 times in 10 min,
# so a broken release does not hammer TradingView.
StartLimitIntervalSec=600
StartLimitBurst=5
Description=goldbot TradingView direct pull (follow: one read-only pass per 15m bar)
After=network-online.target
Wants=network-online.target

[Service]
User=goldbot
WorkingDirectory=/opt/goldbot
Environment=PYTHON_KEYRING_BACKEND=keyring.backends.fail.Keyring
ExecStart=/opt/goldbot/.venv/bin/python -m goldbot.ops.run tv-pull follow --state /opt/goldbot/state
Restart=on-failure
RestartSec=60
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/goldbot/state /opt/goldbot/logs /opt/goldbot/data /var/lib/goldbot
PrivateTmp=true

[Install]
WantedBy=multi-user.target
